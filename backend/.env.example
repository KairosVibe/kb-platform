# 部署期环境变量模板（**进版本库**）。实际值放同目录 .env（不进版本库）。
#
# 权威声明：docs/DEPLOYMENT.md §9.2。本文件与 config.py 的默认值必须与该节一致。
#   用法：cp .env.example .env 然后按注释填值。

# ---- 运行环境 ----
APP_ENV=dev
# APP_NAME=kb-platform
# API_PREFIX=/api

# ---- 数据库 ----
# D-09（2026-09-17）：MySQL 由 VM 容器承载（`192.168.62.128` 上的 `mysql:8.0.26`），
# 不再使用宿主 Windows 服务 `MySQL80`。字符集/排序规则与宿主保持一致（utf8mb4 / utf8mb4_0900_ai_ci）。
# ★ 集成测试库由本值**派生**（库名追加 `_it`），改动它会同时移动测试目标库。
DATABASE_URL=mysql+aiomysql://kb:kb_pass@192.168.62.128:3306/kb_platform?charset=utf8mb4
# DB_ECHO=false

# ---- JWT ----
# 长度必须 >= 32 字符，否则启动即失败；留空则用开发默认值（仅限 dev）。
JWT_SECRET=please-change-me-to-a-random-string-of-at-least-32-chars

# ---- 向量库（双形态，二者必须一致）----
# standalone: MILVUS_URI 必须是 http(s):// 地址
# lite      : MILVUS_URI 必须是文件路径（**仅 Linux/macOS 可用**，Windows 上无法工作）
# 只改其中一个会在启动期直接失败——这是有意设计，避免连到错误的形态。
VECTOR_BACKEND=milvus_standalone
MILVUS_URI=http://192.168.62.128:19530
# MILVUS_COLLECTION=kb_chunks
# FAQ_COLLECTION=faq_q

# ---- 图库（Neo4j，D-08：由 VM 承载）----
# NEO4J_URI 必须以 bolt:// 或 neo4j:// 开头
NEO4J_URI=bolt://192.168.62.128:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-to-the-password-in-the-vm-rag-env

# ---- 云模型（D-03：OpenAI 兼容接口）----
# 不填则调用失败；不要提交真实密钥。
DASHSCOPE_API_KEY=
# EMBED_PROVIDER=qwen
# EMBED_MODEL=text-embedding-v3
# EMBED_DIM=1024
