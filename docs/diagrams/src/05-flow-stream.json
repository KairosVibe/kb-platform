{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "流式恢复与撤权 · R3 设计",
    "locale": "zh-CN",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "request",
      "label": "请求与事件持久化"
    },
    {
      "id": "read",
      "label": "订阅与恢复"
    },
    {
      "id": "guard",
      "label": "最新身份与终态"
    }
  ],
  "nodes": [
    {
      "id": "accept",
      "lane": "request",
      "col": 0,
      "type": "database",
      "label": "创建幂等请求",
      "sublabel": "user_id / client_request_id",
      "width": 174
    },
    {
      "id": "run",
      "lane": "request",
      "col": 1,
      "type": "backend",
      "label": "执行问答一次",
      "sublabel": "复用图 03 / 单一执行权",
      "width": 174
    },
    {
      "id": "persist",
      "lane": "request",
      "col": 2,
      "type": "database",
      "label": "持久化事件",
      "sublabel": "request_id + 单调 seq",
      "width": 174
    },
    {
      "id": "subscribe",
      "lane": "read",
      "col": 0,
      "type": "frontend",
      "label": "重连订阅 GET",
      "sublabel": "Last-Event-ID / 不重生成",
      "width": 174
    },
    {
      "id": "load",
      "lane": "read",
      "col": 2,
      "type": "backend",
      "label": "读取增量或快照",
      "sublabel": "过期事件仅返回安全快照",
      "width": 174
    },
    {
      "id": "check",
      "lane": "guard",
      "col": 2,
      "type": "security",
      "label": "当前身份与来源复核",
      "sublabel": "含取消 / 撤权 / 来源变化",
      "width": 174
    },
    {
      "id": "send",
      "lane": "guard",
      "col": 3,
      "type": "backend",
      "label": "发送本批事件",
      "sublabel": "短临界区 / 不跨网络等待",
      "width": 174
    },
    {
      "id": "view",
      "lane": "guard",
      "col": 4,
      "type": "frontend",
      "label": "安全显示",
      "sublabel": "Markdown / 引用再次鉴权",
      "width": 174
    },
    {
      "id": "stop",
      "lane": "guard",
      "col": 1,
      "type": "security",
      "label": "停止内容输出",
      "sublabel": "安全错误或取消终态",
      "width": 174
    },
    {
      "id": "finish",
      "lane": "request",
      "col": 4,
      "type": "database",
      "label": "提交唯一终态",
      "sublabel": "审计 / 用量 / done 或 error",
      "width": 174
    }
  ],
  "edges": [
    {
      "id": "accept-run",
      "from": "accept",
      "to": "run",
      "role": "main"
    },
    {
      "id": "run-persist",
      "from": "run",
      "to": "persist",
      "role": "main"
    },
    {
      "id": "persist-load",
      "from": "persist",
      "to": "load",
      "role": "main",
      "label": "已持久事件"
    },
    {
      "id": "subscribe-load",
      "from": "subscribe",
      "to": "load",
      "role": "branch",
      "label": "恢复游标"
    },
    {
      "id": "load-check",
      "from": "load",
      "to": "check",
      "role": "main"
    },
    {
      "id": "check-send",
      "from": "check",
      "to": "send",
      "role": "main",
      "label": "仍可读"
    },
    {
      "id": "send-view",
      "from": "send",
      "to": "view",
      "role": "main"
    },
    {
      "id": "check-stop",
      "from": "check",
      "to": "stop",
      "role": "error",
      "label": "撤权 / 取消",
      "variant": "security"
    },
    {
      "id": "run-finish",
      "from": "run",
      "to": "finish",
      "role": "branch",
      "label": "执行完成"
    }
  ],
  "mainPath": [
    "accept",
    "run",
    "persist",
    "load",
    "check",
    "send",
    "view"
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "终态与断线",
      "items": [
        "终态提交后发布 done/error；终态事件发送仍经过当前安全检查。",
        "断线不等于取消；进程重启将孤儿运行请求恢复为可解释状态，不自动重复生成。"
      ]
    },
    {
      "dot": "rose",
      "title": "安全边界",
      "items": [
        "ACL 提交与发送决定串联；网络发送不占用长锁。",
        "已发送字节不可撤回；历史、引用、重连均复核来源。"
      ]
    }
  ]
}
